# Образец файла настроек. Скопируйте его в .env и впишите свои значения:
#   copy .env.example .env        (Windows)
# Файл .env в Git не добавляется, поэтому секреты из него не утекут.

# --- Django ---
# Секретный ключ. Сгенерировать новый:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# True: режим разработки на своём компьютере. На сервере обязательно False.
DJANGO_DEBUG=True
# Адреса, по которым открывается сайт, через запятую. На сервере добавьте свой домен.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Для сервера с https: https://example.ru (через запятую, если несколько). Локально оставьте пустым.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Данные о вузах ---
# True: показывать и непроверенные программы (с пометкой «не проверено»).
# False: только проверенные вручную. Для реального запуска False.
SHOW_UNVERIFIED_DATA=True

# --- Qwen ---
# Пока ключ пустой, вместо ответа модели показывается заглушка.
QWEN_API_KEY=
# Адрес API в формате OpenAI. Примеры:
#   Alibaba Cloud, международный регион: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Alibaba Cloud, Китай:               https://dashscope.aliyuncs.com/compatible-mode/v1
#   своя модель через vLLM/Ollama:      http://localhost:8000/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Название модели у выбранного провайдера, например qwen-plus, qwen-turbo, qwen-max
QWEN_MODEL=qwen-plus
# Максимум токенов в ответе: ограничивает расход
QWEN_MAX_TOKENS=2500
# Сколько секунд ждать ответа
QWEN_TIMEOUT=60
